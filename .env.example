# Copy to .env (gitignored) and run with: uv run --env-file .env schemagraph ask "..." -c shop

# --- OpenRouter: one key for Qwen (generator, critic) and Jev (judge, selector) ---
OPENROUTER_API_KEY=
SCHEMAGRAPH_GEN_MODEL=openrouter:qwen/qwen3.8-max-0902
# off | low | medium | high (default medium)
SCHEMAGRAPH_REASONING=medium

# Jev through OpenRouter's TypeSafe-compatible endpoint; the TypeSafe SDK reads its own key
# variable, so the OpenRouter key goes here too.
TYPESAFE_BASE_URL=https://openrouter.ai/api
TYPESAFE_API_KEY=
SCHEMAGRAPH_JUDGE_MODEL=typesafe:typesafe/jev-1.13

# --- Or the direct providers (the defaults): leave the lines above unset ---
# DASHSCOPE_API_KEY=        # alibaba:qwen3.8-max
# TYPESAFE_API_KEY=         # typesafe:jev-1.13.0, with TYPESAFE_BASE_URL unset
